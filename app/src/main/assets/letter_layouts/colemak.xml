<?xml version="1.0" encoding="utf-8"?>
<!-- Colemak, for the on-screen keyboard. A source document, kept by hand.

     xt9kdb-scaffold/tools/letter_layouts_gen.py writes the on-screen letter rows from it
     (res/xml/rowkeys_colemak1.xml to rowkeys_colemak3.xml); res/xml/rows_colemak.xml, also kept by
     hand, arranges them with the keyboard's other keys. Edit this file, then rerun the generator.

     The rows template is "spanish": ten keys in the middle row, because Colemak puts o where QWERTY
     has the semicolon key. The hold lists are the English ones; the generated rows refer to the
     keyboard language's own list wherever a list here is the English one, so a Colemak board on a
     French keyboard offers the French accents.

     On screen only (targets="vkb"): choosing it for a keyboard language changes the on-screen
     keyboard and the engine's on-screen key positions, never the physical keys. It is bound to no
     language, so every keyboard written in the Latin alphabet may choose it. -->
<letter-layout version="1" id="colemak" name="Colemak" targets="vkb">
    <bind/>
    <rows template="spanish"/>
    <key code="KEYCODE_Q" keySpec="q"/>
    <key code="KEYCODE_W" keySpec="w"/>
    <key code="KEYCODE_E" keySpec="f"/>
    <key code="KEYCODE_R" keySpec="p"/>
    <key code="KEYCODE_T" keySpec="g"/>
    <key code="KEYCODE_Y" keySpec="j"/>
    <key code="KEYCODE_U" keySpec="l"/>
    <key code="KEYCODE_I" keySpec="u" moreKeys="ú,û,ü,ù,ū"/>
    <key code="KEYCODE_O" keySpec="y"/>
    <key code="KEYCODE_P" keySpec=";" moreKeys=":"/>
    <key code="KEYCODE_A" keySpec="a" moreKeys="à,á,â,ä,æ,ã,å,ā"/>
    <key code="KEYCODE_S" keySpec="r" moreKeys="®"/>
    <key code="KEYCODE_D" keySpec="s" moreKeys="ß"/>
    <key code="KEYCODE_F" keySpec="t" moreKeys="™"/>
    <key code="KEYCODE_G" keySpec="d"/>
    <key code="KEYCODE_H" keySpec="h"/>
    <key code="KEYCODE_J" keySpec="n" moreKeys="ñ"/>
    <key code="KEYCODE_K" keySpec="e" moreKeys="é,è,ê,ë,ē"/>
    <key code="KEYCODE_L" keySpec="i" moreKeys="í,î,ï,ī,ì"/>
    <key code="KEYCODE_SEMICOLON" keySpec="o" moreKeys="ó,ô,ö,ò,œ,ø,ō,õ"/>
    <key code="KEYCODE_Z" keySpec="z"/>
    <key code="KEYCODE_X" keySpec="x"/>
    <key code="KEYCODE_C" keySpec="c" moreKeys="ç,©"/>
    <key code="KEYCODE_V" keySpec="v"/>
    <key code="KEYCODE_B" keySpec="b"/>
    <key code="KEYCODE_N" keySpec="k"/>
    <key code="KEYCODE_M" keySpec="m"/>
</letter-layout>
