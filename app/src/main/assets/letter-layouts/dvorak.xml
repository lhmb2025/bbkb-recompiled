<?xml version="1.0" encoding="utf-8"?>
<!-- Dvorak, for the on-screen keyboard. A source document, kept by hand.

     xt9kdb-scaffold/tools/letter_layouts_gen.py writes the on-screen letter rows from it
     (res/xml/rowkeys_dvorak1.xml to rowkeys_dvorak3.xml); res/xml/rows_dvorak.xml, also kept by
     hand, arranges them with the keyboard's other keys. Edit this file, then rerun the generator.

     The rows template is "spanish": ten keys in the middle row, because Dvorak puts s where QWERTY
     has the semicolon key. The hold lists are the English ones; the generated rows refer to the
     keyboard language's own list wherever a list here is the English one.

     On screen only (targets="vkb"): choosing it for a keyboard language changes the on-screen
     keyboard and the engine's on-screen key positions, never the physical keys. It is bound to no
     language, so every keyboard written in the Latin alphabet may choose it.

     Two things the on-screen keyboard keeps outside this document:
     - The three punctuation keys on Q, W and E. On screen they come from res/xml/keys_dvorak_123.xml,
       which rows_dvorak.xml puts ahead of the generated first row, because they carry digit hints
       and change in web address and email fields. The generator checks that the two agree.
     - q and z. On screen they are the bottom row's comma and period keys (key_comma.xml and
       key_period.xml switch on the dvorak layout set), a row this document has no positions for. -->
<letter-layout version="1" id="dvorak" name="Dvorak" targets="vkb">
    <bind/>
    <rows template="spanish"/>
    <key code="KEYCODE_Q" keySpec="'" characterMapKeys="&quot;" moreKeys="!,&quot;"/>
    <key code="KEYCODE_W" keySpec="," characterMapKeys="&lt;" moreKeys="?"/>
    <key code="KEYCODE_E" keySpec="." characterMapKeys="&gt;"/>
    <key code="KEYCODE_R" keySpec="p"/>
    <key code="KEYCODE_T" keySpec="y"/>
    <key code="KEYCODE_Y" keySpec="f"/>
    <key code="KEYCODE_U" keySpec="g"/>
    <key code="KEYCODE_I" keySpec="c" moreKeys="ç,©"/>
    <key code="KEYCODE_O" keySpec="r" moreKeys="®"/>
    <key code="KEYCODE_P" keySpec="l"/>
    <key code="KEYCODE_A" keySpec="a" moreKeys="à,á,â,ä,æ,ã,å,ā"/>
    <key code="KEYCODE_S" keySpec="o" moreKeys="ó,ô,ö,ò,œ,ø,ō,õ"/>
    <key code="KEYCODE_D" keySpec="e" moreKeys="é,è,ê,ë,ē"/>
    <key code="KEYCODE_F" keySpec="u" moreKeys="ú,û,ü,ù,ū"/>
    <key code="KEYCODE_G" keySpec="i" moreKeys="í,î,ï,ī,ì"/>
    <key code="KEYCODE_H" keySpec="d"/>
    <key code="KEYCODE_J" keySpec="h"/>
    <key code="KEYCODE_K" keySpec="t" moreKeys="™"/>
    <key code="KEYCODE_L" keySpec="n" moreKeys="ñ"/>
    <key code="KEYCODE_SEMICOLON" keySpec="s" moreKeys="ß"/>
    <key code="KEYCODE_Z" keySpec="j"/>
    <key code="KEYCODE_X" keySpec="k"/>
    <key code="KEYCODE_C" keySpec="x"/>
    <key code="KEYCODE_V" keySpec="b"/>
    <key code="KEYCODE_B" keySpec="m"/>
    <key code="KEYCODE_N" keySpec="w"/>
    <key code="KEYCODE_M" keySpec="v"/>
</letter-layout>
