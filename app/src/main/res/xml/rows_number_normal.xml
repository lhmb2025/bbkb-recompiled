<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <Row>
        <Spacer latin:backgroundType="normal"/>
        <Key
            latin:keySpec="1"
            latin:keyStyle="numKeyStyle"/>
        <Key
            latin:keySpec="2"
            latin:keyStyle="numKeyStyle"/>
        <Key
            latin:keySpec="3"
            latin:keyStyle="numKeyStyle"/>
        <switch>
            <case latin:mode="time|datetime">
                <Key
                    latin:keySpec="-"
                    latin:keyStyle="numTimeDashKeyStyle"
                    latin:moreKeys="!text/morekeys_am_pm"/>
            </case>
            <default>
                <Key
                    latin:keySpec="-"
                    latin:keyStyle="numFunctionalKeyStyle"/>
            </default>
        </switch>
        <Spacer latin:backgroundType="normal"/>
    </Row>
    <Row>
        <Spacer latin:backgroundType="normal"/>
        <Key
            latin:keySpec="4"
            latin:keyStyle="numKeyStyle"/>
        <Key
            latin:keySpec="5"
            latin:keyStyle="numKeyStyle"/>
        <Key
            latin:keySpec="6"
            latin:keyStyle="numKeyStyle"/>
        <switch>
            <case latin:mode="date|time|datetime">
                <Key
                    latin:keySpec="."
                    latin:keyStyle="numInputBoardToggleKeyStyle"
                    latin:secondaryFunctionDisplayStyle="topRightCorner"
                    latin:secondaryKeySpec="!icon/show_input_menu_key|!code/key_show_input_menu"/>
            </case>
            <default>
                <Key
                    latin:keySpec="+"
                    latin:keyStyle="numFunctionalKeyStyle"/>
            </default>
        </switch>
        <Spacer latin:backgroundType="normal"/>
    </Row>
    <Row>
        <Spacer latin:backgroundType="normal"/>
        <Key
            latin:keySpec="7"
            latin:keyStyle="numKeyStyle"/>
        <Key
            latin:keySpec="8"
            latin:keyStyle="numKeyStyle"/>
        <Key
            latin:keySpec="9"
            latin:keyStyle="numKeyStyle"/>
        <Key latin:keyStyle="deleteKeyStyle"/>
        <Spacer latin:backgroundType="normal"/>
    </Row>
    <Row>
        <Spacer latin:backgroundType="normal"/>
        <switch>
            <case latin:mode="date">
                <Key
                    latin:keySpec="/"
                    latin:keyStyle="numKeyStyle"/>
            </case>
            <case latin:mode="time">
                <Key
                    latin:keySpec=":"
                    latin:keyStyle="numKeyStyle"/>
            </case>
            <case latin:mode="datetime">
                <Key
                    latin:keySpec="/ :|/"
                    latin:keyStyle="numKeyStyle"
                    latin:moreKeys="!noPanelAutoMoreKey!,:"/>
            </case>
            <default>
                <Key
                    latin:keySpec="."
                    latin:keyStyle="numKeyStyle"
                    latin:moreKeys=","/>
            </default>
        </switch>
        <Key
            latin:keySpec="0"
            latin:keyStyle="numKeyStyle"/>
        <Key latin:keyStyle="numSpaceKeyStyle"/>
        <Key latin:keyStyle="enterKeyStyle"/>
        <Spacer latin:backgroundType="normal"/>
    </Row>
</merge>
