<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <switch>
        <case latin:keyboardLayoutSetElement="alphabetShiftLockShifted">
            <Key latin:keySpec="ඞ"/>
            <Key latin:keySpec="ඣ"/>
            <Key latin:keySpec="ඪ"/>
            <Key latin:keySpec="ඊ"/>
            <Key latin:keySpec="භ"/>
            <Key latin:keySpec="ඵ"/>
            <Key latin:keySpec="ළ"/>
            <Key latin:keySpec="ඝ"/>
            <Key latin:keySpec="ර්‍"/>
        </case>
        <default>
            <Key
                latin:keySpec="ං"
                latin:moreKeys="ඃ"/>
            <Key
                latin:keySpec="ජ"
                latin:moreKeys="ඦ"/>
            <Key
                latin:keySpec="ඩ"
                latin:moreKeys="ඬ"/>
            <Key latin:keySpec="ඉ"/>
            <Key latin:keySpec="බ"/>
            <Key latin:keySpec="ප"/>
            <Key latin:keySpec="ල"/>
            <Key
                latin:keySpec="ග"
                latin:moreKeys="ඟ"/>
            <Key latin:keySpec="ෳ"/>
        </default>
    </switch>
</merge>
