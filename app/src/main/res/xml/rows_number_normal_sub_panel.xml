<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <include latin:keyboardLayout="@xml/key_styles_currency"/>
    <Row>
        <Spacer latin:backgroundType="normal"/>
        <Key
            latin:keySpec="7"
            latin:keyStyle="numKeySubPanelStyle"/>
        <Key
            latin:keySpec="8"
            latin:keyStyle="numKeySubPanelStyle"/>
        <Key
            latin:keySpec="9"
            latin:keyStyle="numKeySubPanelStyle"/>
        <Key
            latin:keySpec="&amp;"
            latin:keyStyle="numFunctionalKeySubPanelStyle"/>
        <Key
            latin:keySpec="*"
            latin:keyStyle="numFunctionalKeySubPanelStyle"/>
        <Spacer latin:backgroundType="normal"/>
    </Row>
    <Row>
        <Spacer latin:backgroundType="normal"/>
        <Key
            latin:keySpec="4"
            latin:keyStyle="numKeySubPanelStyle"/>
        <Key
            latin:keySpec="5"
            latin:keyStyle="numKeySubPanelStyle"/>
        <Key
            latin:keySpec="6"
            latin:keyStyle="numKeySubPanelStyle"/>
        <Key
            latin:backgroundType="slideFunctional"
            latin:keyStyle="currencyExtendedKeyStyle"/>
        <Key
            latin:keySpec="%"
            latin:keyStyle="numFunctionalKeySubPanelStyle"/>
        <Spacer latin:backgroundType="normal"/>
    </Row>
    <Row>
        <Spacer latin:backgroundType="normal"/>
        <Key
            latin:keySpec="1"
            latin:keyStyle="numKeySubPanelStyle"/>
        <Key
            latin:keySpec="2"
            latin:keyStyle="numKeySubPanelStyle"/>
        <Key
            latin:keySpec="3"
            latin:keyStyle="numKeySubPanelStyle"/>
        <Key
            latin:keySpec="@"
            latin:keyStyle="numFunctionalKeySubPanelStyle"/>
        <Key
            latin:keySpec="#"
            latin:keyStyle="numFunctionalKeySubPanelStyle"/>
        <Spacer latin:backgroundType="normal"/>
    </Row>
    <Row>
        <Spacer latin:backgroundType="normal"/>
        <Key
            latin:keySpec="0"
            latin:keyStyle="numKeySubPanelStyle"/>
        <Key
            latin:keySpec="."
            latin:keyStyle="numKeySubPanelStyle"/>
        <Key
            latin:keySpec="!text/keyspec_comma"
            latin:keyStyle="numKeySubPanelStyle"/>
        <Key
            latin:keySpec="!text/keyspec_symbols_question"
            latin:keyStyle="numFunctionalKeySubPanelStyle"
            latin:moreKeys="!text/morekeys_question"/>
        <Key
            latin:keySpec="!"
            latin:keyStyle="numFunctionalKeySubPanelStyle"/>
        <Spacer latin:backgroundType="normal"/>
    </Row>
</merge>
