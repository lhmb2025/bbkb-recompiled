<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <Key
        latin:keySpec="!text/keyspec_left_double_angle_quote"
        latin:moreKeys="!text/morekeys_double_quote"/>
    <Key
        latin:keySpec="!text/keyspec_right_double_angle_quote"
        latin:moreKeys="!text/morekeys_single_quote"/>
    <Key
        latin:keySpec="™"
        latin:moreKeys="©,®,〒,〶,〠"/>
    <Key
        latin:keySpec="&apos;"
        latin:moreKeys="＇,!text/single_quotes"/>
    <Key
        latin:keySpec="&quot;"
        latin:moreKeys="＂,!text/double_quotes"/>
    <Key
        latin:keySpec=","
        latin:moreKeys="，"/>
    <Key
        latin:keySpec="."
        latin:moreKeys="．,…"/>
</merge>
