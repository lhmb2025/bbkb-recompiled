<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal Phone (MP01), aw9523b-key keypad -->

<device-input-config version="2.1" name="Minimal Phone (MP01)">
    
    <device>
        <match>
            <device-name exact="aw9523b-key"/>
        </match>

        <device-type>PKB</device-type>

        <!-- Sold in one layout; declared so user letter maps bind without live detection -->
        <keypad-layout>qwerty</keypad-layout>

        <!-- E-ink: no pressed highlights, fades, animated previews or gesture trail (DeviceProfile.isEinkDisplay) -->
        <quirk name="eink-display"/>

        <input-mappings>
            <alt-mappings>
                <source>device_alt_mappings_aw9523b</source>
                <enabled>true</enabled>
            </alt-mappings>
            
            <keypad-type>4row</keypad-type>
            
            <layout-overrides>
                <override from="rows_symbols_pkb" to="rows_symbols_pkb_aw9523b"/>
                <override from="rows_symbols_shift_pkb" to="rows_symbols_shift_pkb_aw9523b"/>
            </layout-overrides>

            <scancode-mappings>

                <key rawScanCode="249" role="BOARD_SYM"
                     treatAs="KEYCODE_SYM" notes="BB SYM raw scancode"/>
                <key rawScanCode="63" rawKeyCode="63" role="BOARD_SYM"
                     treatAs="KEYCODE_SYM" notes="SYM via .kl mapping"/>

                <key rawScanCode="250" role="BOARD_EMOJI"
                     treatAs="KEYCODE_EMOJI" altChar="0" board="-11"
                     notes="BB Emoji raw scancode"/>
                <key rawScanCode="666" rawKeyCode="666" role="BOARD_EMOJI"
                     treatAs="KEYCODE_EMOJI" altChar="0" board="-11"
                     notes="Emoji via .kl mapping"/>

                <key rawScanCode="251" role="BOARD_VOICE"
                     treatAs="KEYCODE_MIC" altChar="." board="-27"
                     notes="BB MIC raw scancode"/>
                <key rawScanCode="667" rawKeyCode="667" role="BOARD_VOICE"
                     treatAs="KEYCODE_MIC" altChar="." board="-27"
                     notes="MIC via .kl mapping (period key on Minimal Phone)"/>

            </scancode-mappings>
        </input-mappings>
        
        <settings-overrides>
            <!-- Required for sticky modifiers -->
            <setting key="pref_override_device_meta_state" type="boolean" forced-value="true" read-only="true"/>

            <setting key="type_by_swiping_ckb" type="boolean" forced-value="false" read-only="true"/>
        </settings-overrides>
    </device>

</device-input-config>
