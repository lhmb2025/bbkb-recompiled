<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <switch>
        <case latin:mode="password">
            <Key latin:keySpec="-"/>
            <Key latin:keySpec="_"/>
        </case>
        <default>
            <Key
                latin:keySpec="&apos;"
                latin:moreKeys="&quot;"/>
            <Key
                latin:keySpec="-"
                latin:moreKeys="_"/>
        </default>
    </switch>
    <Key latin:keySpec="ק"/>
    <Key latin:keySpec="ר"/>
    <Key latin:keySpec="א"/>
    <Key latin:keySpec="ט"/>
    <Key latin:keySpec="ו"/>
    <Key latin:keySpec="ן"/>
    <Key latin:keySpec="ם"/>
    <Key latin:keySpec="פ"/>
</merge>
