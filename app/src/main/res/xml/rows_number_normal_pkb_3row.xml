<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <include latin:keyboardLayout="@xml/key_styles_common"/>
    <include latin:keyboardLayout="@xml/key_styles_number"/>
    <Row>
        <switch>
            <case latin:physicalKeypadVariant="azerty">
                <Key
                    latin:keyHintLabel="A"
                    latin:keyMapScanCode="16"
                    latin:keySpec="0"
                    latin:keyStyle="numKeyStyle"/>
                <Key
                    latin:keyHintLabel="Z"
                    latin:keyMapScanCode="17"
                    latin:keySpec="1"
                    latin:keyStyle="numKeyStyle"/>
            </case>
            <default>
                <Key
                    latin:keyHintLabel="Q"
                    latin:keyMapScanCode="16"
                    latin:keySpec="0"
                    latin:keyStyle="numKeyStyle"/>
                <Key
                    latin:keyHintLabel="W"
                    latin:keyMapScanCode="17"
                    latin:keySpec="1"
                    latin:keyStyle="numKeyStyle"/>
            </default>
        </switch>
        <Key
            latin:keyHintLabel="E"
            latin:keyMapScanCode="18"
            latin:keySpec="2"
            latin:keyStyle="numKeyStyle"/>
        <Key
            latin:keyHintLabel="R"
            latin:keyMapScanCode="19"
            latin:keySpec="3"
            latin:keyStyle="numKeyStyle"/>
        <switch>
            <case latin:mode="date|datetime">
                <Key
                    latin:keySpec="/"
                    latin:keyStyle="numFunctionalKeyStyle"/>
            </case>
            <case latin:mode="time">
                <Spacer
                    latin:backgroundType="normal"
                    latin:keyWidth="fillRight"/>
            </case>
            <default>
                <Key
                    latin:keySpec=","
                    latin:keyStyle="numFunctionalKeyStyle"/>
            </default>
        </switch>
    </Row>
    <Row>
        <switch>
            <case latin:physicalKeypadVariant="azerty">
                <Key
                    latin:keyHintLabel="Q"
                    latin:keyMapScanCode="30"
                    latin:keySpec="+"
                    latin:keyStyle="numFunctionalKeyStyle"/>
            </case>
            <default>
                <Key
                    latin:keyHintLabel="A"
                    latin:keyMapScanCode="30"
                    latin:keySpec="+"
                    latin:keyStyle="numFunctionalKeyStyle"/>
            </default>
        </switch>
        <Key
            latin:keyHintLabel="S"
            latin:keyMapScanCode="31"
            latin:keySpec="4"
            latin:keyStyle="numKeyStyle"/>
        <Key
            latin:keyHintLabel="D"
            latin:keyMapScanCode="32"
            latin:keySpec="5"
            latin:keyStyle="numKeyStyle"/>
        <Key
            latin:keyHintLabel="F"
            latin:keyMapScanCode="33"
            latin:keySpec="6"
            latin:keyStyle="numKeyStyle"/>
        <switch>
            <case latin:mode="time|datetime">
                <Key
                    latin:keySpec=":"
                    latin:keyStyle="numFunctionalKeyStyle"/>
            </case>
            <case latin:mode="date">
                <Spacer
                    latin:backgroundType="normal"
                    latin:keyWidth="fillRight"/>
            </case>
            <default>
                <Key
                    latin:keySpec="."
                    latin:keyStyle="numFunctionalKeyStyle"/>
            </default>
        </switch>
    </Row>
    <Row>
        <switch>
            <case latin:physicalKeypadVariant="qwertz">
                <Key
                    latin:keyHintLabel="Y"
                    latin:keyMapScanCode="44"
                    latin:keySpec="-"
                    latin:keyStyle="numFunctionalKeyStyle"/>
            </case>
            <case latin:physicalKeypadVariant="azerty">
                <Key
                    latin:keyHintLabel="W"
                    latin:keyMapScanCode="44"
                    latin:keySpec="-"
                    latin:keyStyle="numFunctionalKeyStyle"/>
            </case>
            <default>
                <Key
                    latin:keyHintLabel="Z"
                    latin:keyMapScanCode="44"
                    latin:keySpec="-"
                    latin:keyStyle="numFunctionalKeyStyle"/>
            </default>
        </switch>
        <Key
            latin:keyHintLabel="X"
            latin:keyMapScanCode="45"
            latin:keySpec="7"
            latin:keyStyle="numKeyStyle"/>
        <Key
            latin:keyHintLabel="C"
            latin:keyMapScanCode="46"
            latin:keySpec="8"
            latin:keyStyle="numKeyStyle"/>
        <Key
            latin:keyHintLabel="V"
            latin:keyMapScanCode="47"
            latin:keySpec="9"
            latin:keyStyle="numKeyStyle"/>
        <switch>
            <case latin:mode="date|time|datetime">
                <Key
                    latin:keySpec="."
                    latin:keyStyle="numFunctionalKeyStyle"/>
            </case>
            <default>
                <Spacer
                    latin:backgroundType="normal"
                    latin:keyWidth="fillRight"/>
            </default>
        </switch>
    </Row>
</merge>
