<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <include latin:keyboardLayout="@xml/key_styles_common"/>
    <include latin:keyboardLayout="@xml/key_styles_number"/>
    <include latin:keyboardLayout="@xml/row_password_numbers"/>
    <Row>
        <Key
            latin:keySpec="!text/keyspec_left_parenthesis_fullwidth"
            latin:keyWidth="15%p"/>
        <Key
            latin:keySpec="？"
            latin:keyWidth="23.3333%p"/>
        <Key
            latin:keySpec="："
            latin:keyWidth="23.3333%p"/>
        <Key
            latin:keySpec="！"
            latin:keyWidth="23.3333%p"/>
        <Key
            latin:keySpec="!text/keyspec_right_parenthesis_fullwidth"
            latin:keyWidth="15%p"/>
    </Row>
    <Row>
        <Key
            latin:keySpec="“"
            latin:keyWidth="15%p"/>
        <Key
            latin:keySpec="一"
            latin:keyWidth="23.3333%p"/>
        <Key
            latin:keySpec="丨"
            latin:keyWidth="23.3333%p"/>
        <Key
            latin:keySpec="丿"
            latin:keyWidth="23.3333%p"/>
        <Key
            latin:keySpec="”"
            latin:keyWidth="15%p"/>
    </Row>
    <Row>
        <Key
            latin:keySpec="分詞|&apos;"
            latin:keyWidth="15%p"/>
        <Key
            latin:keySpec="丶"
            latin:keyWidth="23.3333%p"/>
        <Key
            latin:keySpec="乛"
            latin:keyWidth="23.3333%p"/>
        <Key
            latin:keySpec="通配|*"
            latin:keyWidth="23.3333%p"/>
        <Key
            latin:keyStyle="deleteKeyStyle"
            latin:keyWidth="15%p"/>
    </Row>
    <Row>
        <Key
            latin:keyStyle="toSymbolKeyStyle"
            latin:keyWidth="15%p"
            latin:secondaryKeySpec="ctrl|!code/key_control"/>
        <include latin:keyboardLayout="@xml/key_comma"/>
        <include latin:keyboardLayout="@xml/key_space_4kw"/>
        <include latin:keyboardLayout="@xml/key_period"/>
        <Key
            latin:keyStyle="enterKeyStyle"
            latin:keyWidth="15%p"/>
    </Row>
</merge>
