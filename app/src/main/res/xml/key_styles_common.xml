<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <switch>
        <case latin:keyboardLayoutSetElement="numberSubPanel">
            <key-style
                latin:keyLabelFlags="shiftedLetterActivated|hasShiftedLetterHint"
                latin:styleName="hasShiftedLetterHintStyle"/>
        </case>
        <default>
            <key-style
                latin:keyLabelFlags="hasShiftedLetterHint"
                latin:styleName="hasShiftedLetterHintStyle"/>
        </default>
    </switch>
    <key-style latin:styleName="baseSettingsMoreKeysStyle"/>
    <include latin:keyboardLayout="@xml/key_styles_settings"/>
    <key-style
        latin:keyActionFlags="noKeyPreview"
        latin:keyLabelFlags="preserveCase"
        latin:moreKeys="!noPanelAutoMoreKey!, |!code/key_capslock"
        latin:styleName="baseForShiftKeyStyle"/>
    <switch>
        <case latin:keyboardLayoutSetElement="passwordKeeper">
            <key-style
                latin:backgroundType="stickyOff"
                latin:keySpec="!icon/shift_key_shifted|!code/key_shift"
                latin:parentStyle="baseForShiftKeyStyle"
                latin:styleName="shiftKeyStyle"/>
        </case>
        <case latin:keyboardLayoutSetElement="alphabetShiftLocked|alphabetShiftLockShifted">
            <key-style
                latin:backgroundType="stickyOn"
                latin:keySpec="!icon/shift_key_locked|!code/key_shift"
                latin:parentStyle="baseForShiftKeyStyle"
                latin:styleName="shiftKeyStyle"/>
        </case>
        <case latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetAutomaticShifted">
            <key-style
                latin:backgroundType="stickyOff"
                latin:keySpec="!icon/shift_key_shifted|!code/key_shift"
                latin:parentStyle="baseForShiftKeyStyle"
                latin:styleName="shiftKeyStyle"/>
        </case>
        <default>
            <key-style
                latin:backgroundType="stickyOff"
                latin:keySpec="!icon/shift_key|!code/key_shift"
                latin:parentStyle="baseForShiftKeyStyle"
                latin:styleName="shiftKeyStyle"/>
        </default>
    </switch>
    <switch>
        <case latin:languageCode="ar|fa|iw">
            <key-style
                latin:backgroundType="functional"
                latin:keyActionFlags="noKeyPreview|isRepeatable"
                latin:keySpec="!icon/delete_rtl_key|!code/key_delete"
                latin:styleName="deleteKeyStyle"/>
        </case>
        <default>
            <key-style
                latin:backgroundType="functional"
                latin:keyActionFlags="noKeyPreview|isRepeatable"
                latin:keySpec="!icon/delete_key|!code/key_delete"
                latin:styleName="deleteKeyStyle"/>
        </default>
    </switch>
        <key-style
            latin:backgroundType="action"
            latin:keyActionFlags="noKeyPreview"
            latin:keyLabelFlags="keepBackgroundAspectRatio"
            latin:keySpec="!icon/emoji_action_key|!code/key_emoji"
            latin:styleName="emojiKeyStyle"/>
    <include latin:keyboardLayout="@xml/key_styles_enter"/>
    <key-style
        latin:backgroundType="spacebar"
        latin:keyActionFlags="enableLongPress|noKeyPreview"
        latin:keySpec="!icon/space_key|!code/key_space"
        latin:styleName="spaceKeyStyle"/>
    <key-style
        latin:backgroundType="spacebar"
        latin:keyActionFlags="enableLongPress|noKeyPreview"
        latin:keySpec="lang_code|!code/key_space"
        latin:styleName="langCodeSpaceKeyStyle"/>
    <key-style
        latin:keyActionFlags="noKeyPreview"
        latin:keyLabelFlags="hasPopupHint"
        latin:keySpec="!icon/zwnj_key|‌"
        latin:moreKeys="!icon/zwj_key|‍"
        latin:styleName="zwnjKeyStyle"/>
    <key-style
        latin:altCode="!code/key_space"
        latin:keyActionFlags="altCodeWhileTyping|noKeyPreview"
        latin:keyIconDisabled="!icon/shortcut_key_disabled"
        latin:keySpec="!icon/shortcut_key|!code/key_shortcut"
        latin:parentStyle="settingsMoreKeysStyle"
        latin:styleName="shortcutKeyStyle"/>
    <key-style
        latin:altCode="!code/key_space"
        latin:backgroundType="functional"
        latin:keyActionFlags="altCodeWhileTyping|noKeyPreview"
        latin:keySpec="!icon/settings_key|!code/key_settings"
        latin:styleName="settingsKeyStyle"/>
    <key-style
        latin:altCode="!code/key_space"
        latin:keyActionFlags="enableLongPress|altCodeWhileTyping|noKeyPreview"
        latin:keySpec="!icon/language_switch_key|!code/key_language_switch"
        latin:styleName="languageSwitchKeyStyle"/>
    <key-style
        latin:backgroundType="functional"
        latin:keySpec="!icon/tab_key|!code/key_tab"
        latin:styleName="tabKeyStyle"/>
    <key-style
        latin:keySpec="!icon/tab_key|!code/key_tab"
        latin:styleName="nonSpecialBackgroundTabKeyStyle"/>
    <key-style
        latin:backgroundType="functional"
        latin:keyActionFlags="noKeyPreview"
        latin:keyLabelFlags="followFunctionalTextColor|preserveCase"
        latin:styleName="baseForLayoutSwitchKeyStyle"/>
    <key-style
        latin:keySpec="!text/keylabel_to_symbol|!code/key_switch_alpha_symbol"
        latin:parentStyle="baseForLayoutSwitchKeyStyle"
        latin:styleName="toSymbolKeyStyle"/>
    <key-style
        latin:keySpec="!text/keylabel_to_alpha|!code/key_switch_alpha_symbol"
        latin:parentStyle="baseForLayoutSwitchKeyStyle"
        latin:styleName="toAlphaKeyStyle"/>
    <key-style
        latin:keySpec="!text/keylabel_to_more_symbol|!code/key_symbols_page_switch"
        latin:parentStyle="baseForLayoutSwitchKeyStyle"
        latin:styleName="toMoreSymbolKeyStyle"/>
    <key-style
        latin:keyHintLabel="!text/keylabel_to_cangjie_quick_switch"
        latin:keySpec="!text/keylabel_to_cangjie_switch|!code/key_cangjie_regular_switch"
        latin:parentStyle="baseForLayoutSwitchKeyStyle"
        latin:styleName="toCangjieKeyStyle"/>
    <key-style
        latin:keyHintLabel="!text/keylabel_to_cangjie_switch"
        latin:keySpec="!text/keylabel_to_cangjie_quick_switch|!code/key_cangjie_quick_switch"
        latin:parentStyle="baseForLayoutSwitchKeyStyle"
        latin:styleName="toQuickCangjieKeyStyle"/>
    <key-style
        latin:keySpec="!text/keylabel_to_symbol|!code/key_symbols_page_switch"
        latin:parentStyle="baseForLayoutSwitchKeyStyle"
        latin:styleName="backFromMoreSymbolKeyStyle"/>
    <key-style
        latin:backgroundType="functional"
        latin:keyLabelFlags="preserveCase|autoXScale|hasPopupHint|fontNormal"
        latin:keySpec="!text/keyspec_popular_domain"
        latin:moreKeys="!text/morekeys_popular_domain"
        latin:styleName="comKeyStyle"/>
    <key-style latin:styleName="customSymbolKeyStyle"/>
    <key-style latin:styleName="inputBoardToggleKeyStyle"/>
</merge>
