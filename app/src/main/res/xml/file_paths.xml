<?xml version="1.0" encoding="utf-8"?>
<paths>
    <files-path
        name="dynamic"
        path="dynamic/"/>
    <files-path
        name="work"
        path="work/"/>
    <files-path
        name="nuance"
        path="nuance/"/>
    <!-- Device configs (imported and builder-written), shared by the builder -->
