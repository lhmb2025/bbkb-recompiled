<?xml version="1.0" encoding="utf-8"?>
<paths>
    <files-path
        name="dynamic"
        path="dynamic/"/>
    <files-path
        name="work"
        path="work/"/>
    <files-path
        name="nuance"
        path="nuance/"/>
    <!-- Device configs: imported ones and the ones the profile builder writes. Shared out of
         here by the builder's "Share" action, so another handset can import the same file. -->
    <files-path
        name="device_configs"
        path="device_configs/"/>
    <!-- cacheDir/downloads/ — DistributionConfig.downloadDir. A downloaded APK has to be handed
         to the platform installer as a content:// URI (file:// is refused since API 24), so
         ApkInstaller needs this provider to be able to serve out of that directory. Extending the
         existing provider rather than declaring a second one: one authority, one paths file. -->
    <cache-path
        name="downloads"
        path="downloads/"/>
</paths>
