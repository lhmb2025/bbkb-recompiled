<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <include latin:keyboardLayout="@xml/key_styles_common"/>
    <include latin:keyboardLayout="@xml/key_styles_number"/>
    <switch>
        <case latin:passwordInput="true">
            <include latin:keyboardLayout="@xml/rows_number_password_pkb_3row"/>
        </case>
        <default>
            <include latin:keyboardLayout="@xml/rows_number_normal_pkb_3row"/>
        </default>
    </switch>
</merge>
