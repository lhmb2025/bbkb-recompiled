<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <switch>
        <case latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted">
            <Key latin:keySpec="ྮ"/>
            <Key latin:keySpec="ྯ"/>
            <Key latin:keySpec="ྰ"/>
            <Key latin:keySpec="ྱ"/>
            <Key latin:keySpec="ྲ"/>
            <Key latin:keySpec="ླ"/>
            <Key latin:keySpec="ྴ"/>
            <Key latin:keySpec="ྶ"/>
            <Key latin:keySpec="ྷ"/>
            <Key latin:keySpec="ྸ"/>
        </case>
        <default>
            <Key
                latin:keySpec="ཞ"
                latin:moreKeys="ྮ"/>
            <Key
                latin:keySpec="ཟ"
                latin:moreKeys="ྯ"/>
            <Key
                latin:keySpec="འ"
                latin:moreKeys="ྰ"/>
            <Key
                latin:keySpec="ཡ"
                latin:moreKeys="ྱ"/>
            <Key
                latin:keySpec="ར"
                latin:moreKeys="ྲ"/>
            <Key
                latin:keySpec="ལ"
                latin:moreKeys="ླ"/>
            <Key
                latin:keySpec="ཤ"
                latin:moreKeys="ྴ,ཥ"/>
            <Key
                latin:keySpec="ས"
                latin:moreKeys="ྶ"/>
            <Key
                latin:keySpec="ཧ"
                latin:moreKeys="ྷ"/>
            <Key
                latin:keySpec="ཨ"
                latin:moreKeys="ྸ"/>
        </default>
    </switch>
</merge>
