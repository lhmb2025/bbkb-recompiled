<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <!-- backgroundType="empty": the arrow bar replaces the suggestion strip in place, so
         its keys paint no surface of their own and show the container's background,
         matching the strip's flat look. -->
    <Row
        latin:backgroundType="empty"
        latin:keyWidth="25%p">
        <Key latin:keySpec="!icon/arrow_left_key|!code/key_arrow_left"/>
        <Key latin:keySpec="!icon/arrow_right_key|!code/key_arrow_right"/>
        <Key latin:keySpec="!icon/arrow_up_key|!code/key_arrow_up"/>
        <Key latin:keySpec="!icon/arrow_down_key|!code/key_arrow_down"/>
    </Row>
</merge>
