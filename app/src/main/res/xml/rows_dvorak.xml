<?xml version="1.0" encoding="utf-8"?>
<!-- Hand-kept; rowkeys_dvorak1..3 come from letter_layouts_gen.py (ten-key middle row, as spanish). Row 1 opens with the keys_dvorak_123 punctuation keys -->
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <include latin:keyboardLayout="@xml/key_styles_common"/>
    <include latin:keyboardLayout="@xml/row_password_numbers"/>
    <Row latin:keyWidth="10%p">
        <include latin:keyboardLayout="@xml/keys_dvorak_123"/>
        <include latin:keyboardLayout="@xml/rowkeys_dvorak1"/>
    </Row>
    <Row latin:keyWidth="10%p">
        <include latin:keyboardLayout="@xml/rowkeys_dvorak2"/>
    </Row>
    <Row latin:keyWidth="10%p">
        <Key
            latin:keyStyle="shiftKeyStyle"
            latin:keyWidth="15%p"/>
        <include latin:keyboardLayout="@xml/rowkeys_dvorak3"/>
        <Key
            latin:keyStyle="deleteKeyStyle"
            latin:keyWidth="fillRight"/>
    </Row>
    <include latin:keyboardLayout="@xml/row_qwerty4"/>
</merge>
