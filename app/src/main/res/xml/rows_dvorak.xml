<?xml version="1.0" encoding="utf-8"?>
<!-- Kept by hand. The letter rows rowkeys_dvorak1..3 are generated from
     assets/letter_layouts/dvorak.xml by xt9kdb-scaffold/tools/letter_layouts_gen.py. Its rows
     template is "spanish", ten keys in the middle row, so that row is ten keys of 10%p, as in
     rows_spanish.xml and the engine's spanish_vkb.xml, not nine keys between spacers.

     The first row starts with the three punctuation keys of keys_dvorak_123.xml: they carry digit
     hints and change in web address and email fields, which a letter-layout document cannot say.
     The generator writes rowkeys_dvorak1 from the fourth position on and checks that these three
     keys type what the document puts on Q, W and E. -->
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <include latin:keyboardLayout="@xml/key_styles_common"/>
    <include latin:keyboardLayout="@xml/row_password_numbers"/>
    <Row latin:keyWidth="10%p">
        <include latin:keyboardLayout="@xml/keys_dvorak_123"/>
        <include latin:keyboardLayout="@xml/rowkeys_dvorak1"/>
    </Row>
    <Row latin:keyWidth="10%p">
        <include latin:keyboardLayout="@xml/rowkeys_dvorak2"/>
    </Row>
    <Row latin:keyWidth="10%p">
        <Key
            latin:keyStyle="shiftKeyStyle"
            latin:keyWidth="15%p"/>
        <include latin:keyboardLayout="@xml/rowkeys_dvorak3"/>
        <Key
            latin:keyStyle="deleteKeyStyle"
            latin:keyWidth="fillRight"/>
    </Row>
    <include latin:keyboardLayout="@xml/row_qwerty4"/>
</merge>
