<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <switch>
        <case latin:passwordInput="true">
            <Row latin:keyWidth="10%p">
                <switch>
                    <case latin:keyboardLayoutSetElement="symbols">
                        <include latin:keyboardLayout="@xml/rowkeys_symbols1_shift_password"/>
                    </case>
                    <default>
                        <include latin:keyboardLayout="@xml/rowkeys_symbols1"/>
                    </default>
                </switch>
            </Row>
        </case>
    </switch>
</merge>
