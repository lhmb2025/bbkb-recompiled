<?xml version="1.0" encoding="utf-8"?>
<!-- The minus key shows U+2212 but types ASCII hyphen-minus so number parsers accept it -->
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <key-style
        latin:keyActionFlags="noKeyPreview"
        latin:backgroundType="normal"
        latin:styleName="numPadKeyStyle"/>
    <key-style
        latin:backgroundType="functional"
        latin:parentStyle="numPadKeyStyle"
        latin:styleName="numPadFunctionalKeyStyle"/>
    <key-style
        latin:keyActionFlags="noKeyPreview|isRepeatable"
        latin:parentStyle="numPadFunctionalKeyStyle"
        latin:styleName="numPadDeleteKeyStyle"/>
    <Row>
        <Key
            latin:keySpec="("
            latin:moreKeys="[,{"
            latin:keyStyle="numPadFunctionalKeyStyle"/>
        <Key
            latin:keySpec=")"
            latin:moreKeys="],}"
            latin:keyStyle="numPadFunctionalKeyStyle"/>
        <Key
            latin:keySpec="7"
            latin:keyStyle="numPadKeyStyle"/>
        <Key
            latin:keySpec="8"
            latin:keyStyle="numPadKeyStyle"/>
        <Key
            latin:keySpec="9"
            latin:keyStyle="numPadKeyStyle"/>
        <Key
            latin:keySpec="+"
            latin:moreKeys="!text/morekeys_plus"
            latin:keyStyle="numPadFunctionalKeyStyle"/>
        <Key
            latin:keySpec="#"
            latin:moreKeys="&#8470;"
            latin:keyStyle="numPadFunctionalKeyStyle"
            latin:keyWidth="fillRight"/>
    </Row>
    <Row>
        <Key
            latin:keySpec="&lt;"
            latin:moreKeys="!text/morekeys_less_than"
            latin:keyStyle="numPadFunctionalKeyStyle"/>
        <Key
            latin:keySpec="&gt;"
            latin:moreKeys="!text/morekeys_greater_than"
            latin:keyStyle="numPadFunctionalKeyStyle"/>
        <Key
            latin:keySpec="4"
            latin:keyStyle="numPadKeyStyle"/>
        <Key
            latin:keySpec="5"
            latin:keyStyle="numPadKeyStyle"/>
        <Key
            latin:keySpec="6"
            latin:keyStyle="numPadKeyStyle"/>
        <Key
            latin:keySpec="−|-"
            latin:moreKeys="±,–,—"
            latin:keyStyle="numPadFunctionalKeyStyle"/>
        <Key
            latin:keySpec="!icon/space_key_for_number_layout|!code/key_space"
            latin:keyStyle="numPadFunctionalKeyStyle"
            latin:keyWidth="fillRight"/>
    </Row>
    <Row>
        <Key
            latin:keySpec="%"
            latin:moreKeys="&#8240;,&#176;,&#8242;,&#8243;"
            latin:keyStyle="numPadFunctionalKeyStyle"/>
        <Key
            latin:keySpec="/"
            latin:moreKeys="\\\\"
            latin:keyStyle="numPadFunctionalKeyStyle"/>
        <Key
            latin:keySpec="1"
            latin:keyStyle="numPadKeyStyle"/>
        <Key
            latin:keySpec="2"
            latin:keyStyle="numPadKeyStyle"/>
        <Key
            latin:keySpec="3"
            latin:keyStyle="numPadKeyStyle"/>
        <Key
            latin:keySpec="×"
            latin:moreKeys="*"
            latin:keyStyle="numPadFunctionalKeyStyle"/>
        <Key
            latin:keySpec="!icon/delete_key|!code/key_delete"
            latin:keyStyle="numPadDeleteKeyStyle"
            latin:keyWidth="fillRight"/>
    </Row>
    <Row>
        <Key
            latin:keySpec="!text/keyspec_currency"
            latin:moreKeys="!text/morekeys_currency_dollar"
            latin:keyStyle="numPadFunctionalKeyStyle"/>
        <Key
            latin:keySpec="^"
            latin:moreKeys="√,²,³"
            latin:keyStyle="numPadFunctionalKeyStyle"/>
        <Key
            latin:keySpec="0"
            latin:keyStyle="numPadKeyStyle"/>
        <Key
            latin:keySpec="."
            latin:moreKeys="\\,,;,:"
            latin:keyStyle="numPadKeyStyle"/>
        <Key
            latin:keySpec="="
            latin:moreKeys="≠,≈"
            latin:keyStyle="numPadFunctionalKeyStyle"/>
        <Key
            latin:keySpec="÷"
            latin:keyStyle="numPadFunctionalKeyStyle"/>
        <Key
            latin:keySpec="!icon/enter_key|!code/key_enter"
            latin:keyStyle="numPadFunctionalKeyStyle"
            latin:keyWidth="fillRight"/>
    </Row>
</merge>
