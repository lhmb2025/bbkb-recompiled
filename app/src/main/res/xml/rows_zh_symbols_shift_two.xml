<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <include latin:keyboardLayout="@xml/key_styles_common"/>
    <include latin:keyboardLayout="@xml/key_styles_currency"/>
    <Row latin:keyWidth="10%p">
        <include latin:keyboardLayout="@xml/rowkeys_zh_symbols_shift_two1"/>
    </Row>
    <Row
        latin:keyWidth="@fraction/config_key_width_9_column"
        latin:spacerWidth="@fraction/config_spacer_width_9_column">
        <Spacer latin:backgroundType="normal"/>
        <include latin:keyboardLayout="@xml/rowkeys_zh_symbols_shift_two2"/>
        <Spacer latin:backgroundType="normal"/>
    </Row>
    <Row latin:keyWidth="10%p">
        <Key
            latin:keyStyle="toMoreSymbolKeyStyle"
            latin:keyWidth="15%p"/>
        <include latin:keyboardLayout="@xml/rowkeys_zh_symbols_shift_two3"/>
        <Key
            latin:keyStyle="deleteKeyStyle"
            latin:keyWidth="15%p"/>
    </Row>
    <include latin:keyboardLayout="@xml/rowkeys_zh_symbols_shift4"/>
</merge>
