<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <include latin:keyboardLayout="@xml/key_styles_common"/>
    <include latin:keyboardLayout="@xml/key_styles_currency"/>
    <Row>
        <switch>
            <case latin:physicalKeypadVariant="azerty">
                <Key
                    latin:keyHintLabel="A"
                    latin:keyMapScanCode="16"
                    latin:keySpec="＃"/>
                <Key
                    latin:keyHintLabel="Z"
                    latin:keyMapScanCode="17"
                    latin:keySpec="!text/keyspec_symbols_fullwidth_1"/>
            </case>
            <default>
                <Key
                    latin:keyHintLabel="Q"
                    latin:keyMapScanCode="16"
                    latin:keySpec="＃"/>
                <Key
                    latin:keyHintLabel="W"
                    latin:keyMapScanCode="17"
                    latin:keySpec="!text/keyspec_symbols_fullwidth_1"/>
            </default>
        </switch>
        <Key
            latin:keyHintLabel="E"
            latin:keyMapScanCode="18"
            latin:keySpec="!text/keyspec_symbols_fullwidth_2"/>
        <Key
            latin:keyHintLabel="R"
            latin:keyMapScanCode="19"
            latin:keySpec="!text/keyspec_symbols_fullwidth_3"/>
        <Key
            latin:keyHintLabel="T"
            latin:keyMapScanCode="20"
            latin:keySpec="!text/keyspec_left_parenthesis_fullwidth"/>
        <switch>
            <case latin:physicalKeypadVariant="qwertz">
                <Key
                    latin:keyHintLabel="Z"
                    latin:keyMapScanCode="21"
                    latin:keySpec="!text/keyspec_right_parenthesis_fullwidth"/>
            </case>
            <default>
                <Key
                    latin:keyHintLabel="Y"
                    latin:keyMapScanCode="21"
                    latin:keySpec="!text/keyspec_right_parenthesis_fullwidth"/>
            </default>
        </switch>
        <Key
            latin:keyHintLabel="U"
            latin:keyMapScanCode="22"
            latin:keySpec="＿"/>
        <Key
            latin:keyHintLabel="I"
            latin:keyMapScanCode="23"
            latin:keySpec="－"/>
        <Key
            latin:keyHintLabel="O"
            latin:keyMapScanCode="24"
            latin:keySpec="＋"/>
        <Key
            latin:keyHintLabel="P"
            latin:keyMapScanCode="25"
            latin:keySpec="＠"
            latin:keyTypeface="bold"/>
    </Row>
    <Row>
        <switch>
            <case latin:physicalKeypadVariant="azerty">
                <Key
                    latin:keyHintLabel="Q"
                    latin:keyMapScanCode="30"
                    latin:keySpec="＊"/>
            </case>
            <default>
                <Key
                    latin:keyHintLabel="A"
                    latin:keyMapScanCode="30"
                    latin:keySpec="＊"/>
            </default>
        </switch>
        <Key
            latin:keyHintLabel="S"
            latin:keyMapScanCode="31"
            latin:keySpec="!text/keyspec_symbols_fullwidth_4"/>
        <Key
            latin:keyHintLabel="D"
            latin:keyMapScanCode="32"
            latin:keySpec="!text/keyspec_symbols_fullwidth_5"/>
        <Key
            latin:keyHintLabel="F"
            latin:keyMapScanCode="33"
            latin:keySpec="!text/keyspec_symbols_fullwidth_6"/>
        <Key
            latin:keyHintLabel="G"
            latin:keyMapScanCode="34"
            latin:keySpec="／"/>
        <Key
            latin:keyHintLabel="H"
            latin:keyMapScanCode="35"
            latin:keySpec="："/>
        <Key
            latin:keyHintLabel="J"
            latin:keyMapScanCode="36"
            latin:keySpec="；"/>
        <Key
            latin:keyHintLabel="K"
            latin:keyMapScanCode="37"
            latin:keySpec="＇"/>
        <Key
            latin:keyHintLabel="L"
            latin:keyMapScanCode="38"
            latin:keySpec="＂"/>
        <Key
            latin:keyStyle="deleteKeyStyle"
            latin:keyWidth="fillRight"/>
    </Row>
    <Row>
        <Key latin:keyStyle="backFromMoreSymbolKeyStyle"/>
        <switch>
            <case latin:physicalKeypadVariant="qwertz">
                <Key
                    latin:keyHintLabel="Y"
                    latin:keyMapScanCode="44"
                    latin:keySpec="!text/keyspec_symbols_fullwidth_7"/>
            </case>
            <case latin:physicalKeypadVariant="azerty">
                <Key
                    latin:keyHintLabel="W"
                    latin:keyMapScanCode="44"
                    latin:keySpec="!text/keyspec_symbols_fullwidth_7"/>
            </case>
            <default>
                <Key
                    latin:keyHintLabel="Z"
                    latin:keyMapScanCode="44"
                    latin:keySpec="!text/keyspec_symbols_fullwidth_7"/>
            </default>
        </switch>
        <Key
            latin:keyHintLabel="X"
            latin:keyMapScanCode="45"
            latin:keySpec="!text/keyspec_symbols_fullwidth_8"/>
        <Key
            latin:keyHintLabel="C"
            latin:keyMapScanCode="46"
            latin:keySpec="!text/keyspec_symbols_fullwidth_9"/>
        <Key
            latin:keyHintLabel="V"
            latin:keyMapScanCode="47"
            latin:keySpec="？"/>
        <Key
            latin:keyHintLabel="B"
            latin:keyMapScanCode="48"
            latin:keySpec="！"/>
        <Key
            latin:keyHintLabel="N"
            latin:keyMapScanCode="49"
            latin:keySpec="!text/keyspec_fullwidth_comma"/>
        <Key
            latin:keyHintLabel="M"
            latin:keyMapScanCode="50"
            latin:keySpec="!text/keyspec_fullwidth_period"/>
        <Key
            latin:keyHintLabel="$"
            latin:keyMapScanCode="5"
            latin:keySpec="＄"/>
        <Key latin:keyStyle="pkbEnterKeyStyle"/>
    </Row>
    <Row>
        <Key
            latin:keyStyle="toAlphaKeyStyle"
            latin:keyWidth="20%p"
            latin:secondaryKeySpec="ctrl|!code/key_control"/>
        <Key
            latin:additionalMoreKeys="!text/additional_morekeys_symbols_0"
            latin:keyMapScanCode="11"
            latin:keySpec="!text/keyspec_symbols_fullwidth_0"
            latin:moreKeys="!text/morekeys_symbols_0"/>
        <include latin:keyboardLayout="@xml/key_space_3kw"/>
        <Key latin:keySpec="!icon/dedicated_show_ib_key|!code/key_show_input_menu"/>
        <Key
            latin:keySpec="!icon/hide_keyboard_big_key|!code/key_hide_symbol_page"
            latin:keyWidth="20%p"/>
    </Row>
</merge>
