<?xml version="1.0" encoding="utf-8"?>
<!-- Titan Pocket and Slim: phone-pad digits only; other Alt chars come from the firmware KCM (AuxCharacterResolver tier 3) -->
<alt-key-mappings>
    <mapping keycode="Q" char="0"/>

    <mapping keycode="W" char="1"/>
    <mapping keycode="E" char="2"/>
    <mapping keycode="R" char="3"/>

    <mapping keycode="S" char="4"/>
    <mapping keycode="D" char="5"/>
    <mapping keycode="F" char="6"/>

    <mapping keycode="X" char="7"/>
    <mapping keycode="C" char="8"/>
    <mapping keycode="V" char="9"/>

    <!-- Alt+Space: the ROM emits private-use U+EF01; a plain space instead -->
    <mapping keycode="SPACE" char=" "/>

</alt-key-mappings>
