<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <switch>
        <case latin:keyboardLayoutSetElement="symbolsShifted">
            <Key
                latin:keyLabelFlags="followKeyLetterRatio"
                latin:keySpec="क्"/>
            <Key
                latin:keyLabelFlags="followKeyLetterRatio"
                latin:keySpec="ह्म"/>
            <Key latin:keySpec="ऋ"/>
            <Key latin:keySpec="ॐ"/>
            <include latin:keyboardLayout="@xml/keystyle_devanagari_vowel_sign_au"/>
            <Key latin:keyStyle="baseKeyDevanagariVowelSignAu"/>
            <Key
                latin:keyLabelFlags="followKeyLetterRatio"
                latin:keySpec="द्य"/>
        </case>
        <default>
            <Key latin:keySpec="श"/>
            <Key latin:keySpec="ह"/>
            <Key latin:keySpec="अ"/>
            <Key latin:keySpec="ख"/>
            <Key latin:keySpec="द"/>
            <Key latin:keySpec="ल"/>
        </default>
    </switch>
</merge>
