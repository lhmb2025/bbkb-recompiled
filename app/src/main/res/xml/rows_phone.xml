<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <include latin:keyboardLayout="@xml/key_styles_common"/>
    <include latin:keyboardLayout="@xml/key_styles_number"/>
    <Row>
        <Spacer latin:backgroundType="normal"/>
        <Key latin:keyStyle="num1KeyStyle"/>
        <Key latin:keyStyle="num2KeyStyle"/>
        <Key latin:keyStyle="num3KeyStyle"/>
        <Key
            latin:keySpec="-"
            latin:keyStyle="numFunctionalKeyStyle"/>
        <Spacer latin:backgroundType="normal"/>
    </Row>
    <Row>
        <Spacer latin:backgroundType="normal"/>
        <Key latin:keyStyle="num4KeyStyle"/>
        <Key latin:keyStyle="num5KeyStyle"/>
        <Key latin:keyStyle="num6KeyStyle"/>
        <Key
            latin:keySpec="."
            latin:keyStyle="numInputBoardToggleKeyStyle"
            latin:secondaryFunctionDisplayStyle="topRightCorner"
            latin:secondaryKeySpec="!icon/show_input_menu_key|!code/key_show_input_menu"/>
        <Spacer latin:backgroundType="normal"/>
    </Row>
    <Row>
        <Spacer latin:backgroundType="normal"/>
        <Key latin:keyStyle="num7KeyStyle"/>
        <Key latin:keyStyle="num8KeyStyle"/>
        <Key latin:keyStyle="num9KeyStyle"/>
        <Key latin:keyStyle="deleteKeyStyle"/>
        <Spacer latin:backgroundType="normal"/>
    </Row>
    <Row>
        <Spacer latin:backgroundType="normal"/>
        <Key latin:keyStyle="numPhoneToSymbolKeyStyle"/>
        <Key
            latin:keySpec="0  +|0"
            latin:keyStyle="num0KeyStyle"
            latin:moreKeys="!noPanelAutoMoreKey!,+"/>
        <Key latin:keyStyle="numSpaceKeyStyle"/>
        <Key latin:keyStyle="enterKeyStyle"/>
        <Spacer latin:backgroundType="normal"/>
    </Row>
</merge>
