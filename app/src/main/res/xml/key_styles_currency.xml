<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <switch>
        <case latin:passwordInput="true">
            <include latin:keyboardLayout="@xml/key_styles_currency_dollar"/>
        </case>
        <case latin:countryCode="AD|AT|BE|CY|EE|FI|FR|DE|GR|IE|IT|XK|LU|MT|MO|ME|NL|PT|SM|SK|SI|ES|VA">
            <include latin:keyboardLayout="@xml/key_styles_currency_euro"/>
        </case>
        <case latin:localeCode="de|es|el|fi|fr|it|nl|sk|sl">
            <include latin:keyboardLayout="@xml/key_styles_currency_euro"/>
        </case>
        <case latin:languageCode="ca|et|lb|mt">
            <include latin:keyboardLayout="@xml/key_styles_currency_euro"/>
        </case>
        <case latin:languageCode="fa|hi|iw|ja|ko|lo|mn|ne|ru|th|tr|uk|vi">
            <include latin:keyboardLayout="@xml/key_styles_currency_generic"/>
        </case>
        <case latin:countryCode="LK">
            <include latin:keyboardLayout="@xml/key_styles_currency_generic"/>
        </case>
        <case latin:countryCode="IN">
            <key-style
                latin:keySpec="₹"
                latin:moreKeys="!text/morekeys_currency_generic"
                latin:styleName="currencyKeyStyle"/>
            <key-style
                latin:keySpec="₹"
                latin:moreKeys="!text/morekeys_currency_generic"
                latin:styleName="currencyExtendedKeyStyle"/>
            <key-style
                latin:keySpec="£"
                latin:styleName="moreCurrency1KeyStyle"/>
            <key-style
                latin:keySpec="€"
                latin:styleName="moreCurrency2KeyStyle"/>
            <key-style
                latin:keySpec="$"
                latin:moreKeys="¢"
                latin:styleName="moreCurrency3KeyStyle"/>
            <key-style
                latin:keySpec="¢"
                latin:styleName="moreCurrency4KeyStyle"/>
        </case>
        <case latin:countryCode="GB">
            <key-style
                latin:keySpec="£"
                latin:moreKeys="¢,$,€,¥,₱"
                latin:styleName="currencyKeyStyle"/>
            <key-style
                latin:keySpec="£"
                latin:moreKeys="!text/morekeys_currency_generic"
                latin:styleName="currencyExtendedKeyStyle"/>
            <key-style
                latin:keySpec="€"
                latin:styleName="moreCurrency1KeyStyle"/>
            <key-style
                latin:keySpec="¥"
                latin:styleName="moreCurrency2KeyStyle"/>
            <key-style
                latin:keySpec="$"
                latin:moreKeys="¢"
                latin:styleName="moreCurrency3KeyStyle"/>
            <key-style
                latin:keySpec="¢"
                latin:styleName="moreCurrency4KeyStyle"/>
        </case>
        <default>
            <include latin:keyboardLayout="@xml/key_styles_currency_generic"/>
        </default>
    </switch>
</merge>
