<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <switch>
        <case latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted">
            <Key latin:keySpec="ྡ"/>
            <Key latin:keySpec="ྣ"/>
            <Key latin:keySpec="ྤ"/>
            <Key latin:keySpec="ྥ"/>
            <Key latin:keySpec="ྦ"/>
            <Key latin:keySpec="ྨ"/>
            <Key latin:keySpec="ྩ"/>
            <Key latin:keySpec="ྪ"/>
            <Key latin:keySpec="ྫ"/>
            <Key latin:keySpec="ྭ"/>
        </case>
        <default>
            <Key
                latin:keySpec="ད"
                latin:moreKeys="ྡ,ཌ,ཌྷ"/>
            <Key
                latin:keySpec="ན"
                latin:moreKeys="ྣ,ཎ"/>
            <Key
                latin:keySpec="པ"
                latin:moreKeys="ྤ"/>
            <Key
                latin:keySpec="ཕ"
                latin:moreKeys="ྥ"/>
            <Key
                latin:keySpec="བ"
                latin:moreKeys="ྦ"/>
            <Key
                latin:keySpec="མ"
                latin:moreKeys="ྨ"/>
            <Key
                latin:keySpec="ཙ"
                latin:moreKeys="ྩ"/>
            <Key
                latin:keySpec="ཚ"
                latin:moreKeys="ྪ"/>
            <Key
                latin:keySpec="ཛ"
                latin:moreKeys="ྫ,ཛྷ"/>
            <Key
                latin:keySpec="ཝ"
                latin:moreKeys="ྭ"/>
        </default>
    </switch>
</merge>
