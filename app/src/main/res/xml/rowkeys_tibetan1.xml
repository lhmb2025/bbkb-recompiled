<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <switch>
        <case latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted">
            <Key latin:keySpec="ྐ"/>
            <Key latin:keySpec="ྑ"/>
            <Key latin:keySpec="ྒ"/>
            <Key latin:keySpec="ྔ"/>
            <Key latin:keySpec="ྕ"/>
            <Key latin:keySpec="ྖ"/>
            <Key latin:keySpec="ྗ"/>
            <Key latin:keySpec="ྙ"/>
            <Key latin:keySpec="ྟ"/>
            <Key latin:keySpec="ྠ"/>
        </case>
        <default>
            <Key
                latin:keySpec="ཀ"
                latin:moreKeys="ྐ,ཀྵ"/>
            <Key
                latin:keySpec="ཁ"
                latin:moreKeys="ྑ"/>
            <Key
                latin:keySpec="ག"
                latin:moreKeys="ྒ,གྷ"/>
            <Key
                latin:keySpec="ང"
                latin:moreKeys="ྔ"/>
            <Key
                latin:keySpec="ཅ"
                latin:moreKeys="ྕ"/>
            <Key
                latin:keySpec="ཆ"
                latin:moreKeys="ྖ"/>
            <Key
                latin:keySpec="ཇ"
                latin:moreKeys="ྗ"/>
            <Key
                latin:keySpec="ཉ"
                latin:moreKeys="ྙ"/>
            <Key
                latin:keySpec="ཏ"
                latin:moreKeys="ྟ,ཊ"/>
            <Key
                latin:keySpec="ཐ"
                latin:moreKeys="ྠ,ཋ"/>
        </default>
    </switch>
</merge>
