<?xml version="1.0" encoding="utf-8"?>
<KeyboardLayoutSet xmlns:latin="http://schemas.android.com/apk/res-auto">
    <Element
        latin:elementKeyboard="@xml/kbd_zh_zhuyin"
        latin:elementName="alphabet"
        latin:enableProximityCharsCorrection="true"/>
    <Element
        latin:elementKeyboard="@xml/kbd_zh_symbols"
        latin:elementName="symbols"/>
    <Element
        latin:elementKeyboard="@xml/kbd_symbols_custom"
        latin:elementName="symbolsCustom"/>
    <Element
        latin:elementKeyboard="@xml/kbd_zh_symbols_pkb"
        latin:elementName="symbolsPkb"/>
    <Element
        latin:elementKeyboard="@xml/kbd_symbols_pkb_custom"
        latin:elementName="symbolsPkbCustom"/>
    <Element
        latin:elementKeyboard="@xml/kbd_zh_symbols_shift"
        latin:elementName="symbolsShifted"/>
    <Element
        latin:elementKeyboard="@xml/kbd_zh_symbols_shift_pkb"
        latin:elementName="symbolsShiftedPkb"/>
    <Element
        latin:elementKeyboard="@xml/kbd_zh_symbols_shift_two"
        latin:elementName="symbolsShiftedTwo"/>
    <Element
        latin:elementKeyboard="@xml/kbd_zh_symbols_shift_two_pkb"
        latin:elementName="symbolsShiftedTwoPkb"/>
    <Element
        latin:elementKeyboard="@xml/kbd_phone"
        latin:elementName="phone"/>
    <Element
        latin:elementKeyboard="@xml/kbd_phone_symbols"
        latin:elementName="phoneSymbols"/>
    <Element
        latin:elementKeyboard="@xml/kbd_number"
        latin:elementName="number"/>
    <Element
        latin:elementKeyboard="@xml/kbd_unified_input_menu_pkb"
        latin:elementName="unifiedInputMenuPkb"/>
</KeyboardLayoutSet>
