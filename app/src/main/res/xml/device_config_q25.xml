<?xml version="1.0" encoding="utf-8"?>
<!--
    Device Configuration: Zinwa Q25
    Schema v2.1

    This configuration is for the Zinwa Q25 and its q25 keyboard.
    It will be auto-selected when the device is detected.
    
    Find device name: adb shell dumpsys input
-->

<device-input-config version="2.1" name="Zinwa Q25">
    
    <device>
        <match>
            <device-name exact="q25"/>
        </match>

        <device-type>PKB</device-type>
        
        <!-- Sold in one layout. Declared so user letter maps bind to it without live detection. -->
        <keypad-layout>qwerty</keypad-layout>

        <input-mappings>
            
            <keypad-type>4row</keypad-type>
            
            <!-- Unified key mapping: scancode/keycode → role routing (schema v2.1) -->
            <scancode-mappings>

                <!-- SYM key: raw BB scancode -->
                <key rawKeyCode="58" role="BOARD_SYM"
                     treatAs="KEYCODE_SYM" notes="BB SYM raw scancode"/>

                <!-- Mic/zero key, as on a BlackBerry: voice input without Alt; with Alt, or in a
                     numeric field, it types '0'. -->
                <key rawKeyCode="7" role="BOARD_VOICE"
                     treatAs="KEYCODE_MIC" altChar="0" board="-27"
                     notes="BB mic key (keyCode=7), alt char is zero digit"/>

            </scancode-mappings>
        </input-mappings>
        
        <settings-overrides>
            <!-- Disable gesture settings (non-capacitive keyboard) -->
            <setting key="type_by_swiping_ckb" type="boolean" forced-value="false" read-only="true"/>
        </settings-overrides>
    </device>

</device-input-config>
