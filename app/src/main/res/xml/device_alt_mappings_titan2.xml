<?xml version="1.0" encoding="utf-8"?>
<alt-key-mappings>
    <mapping keycode="Q" char="0"/>
    <mapping keycode="W" char="1"/>
    <mapping keycode="E" char="2"/>
    <mapping keycode="R" char="3"/>
    <mapping keycode="T" char="("/>
    <mapping keycode="Y" char=")"/>
    <mapping keycode="U" char="-"/>
    <mapping keycode="I" char="_"/>
    <mapping keycode="O" char="/"/>
    <mapping keycode="P" char=":"/>

    <mapping keycode="A" char="@"/>
    <mapping keycode="S" char="4"/>
    <mapping keycode="D" char="5"/>
    <mapping keycode="F" char="6"/>
    <mapping keycode="G" char="*"/>
    <mapping keycode="H" char="#"/>
    <mapping keycode="J" char="+"/>
    <mapping keycode="K" char="&quot;"/>
    <mapping keycode="L" char="'"/>

    <mapping keycode="Z" char="!"/>
    <mapping keycode="X" char="7"/>
    <mapping keycode="C" char="8"/>
    <mapping keycode="V" char="9"/>
    <mapping keycode="B" char="."/>
    <mapping keycode="N" char=","/>
    <mapping keycode="M" char="?"/>

    <!-- Alt+Space: the ROM emits private-use U+EE01 (would show as tofu); a plain space instead -->
    <mapping keycode="SPACE" char=" "/>

</alt-key-mappings>