<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:latin="http://schemas.android.com/apk/res-auto">
    <switch>
        <case latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted">
            <Key latin:keySpec="«"/>
            <Key latin:keySpec="»"/>
            <Key latin:keySpec="‹"/>
            <Key latin:keySpec="›"/>
            <Key latin:keySpec="፠"/>
            <Key latin:keySpec="፧"/>
            <Key latin:keySpec="፨"/>
            <Key latin:keySpec="፦"/>
        </case>
        <default>
            <Key
                latin:keySpec="ፈ"
                latin:moreKeys="ፉ,ፊ,ፋ,ፌ,ፍ,ፎ,ፏ"/>
            <Key
                latin:keySpec="ፐ"
                latin:moreKeys="ፑ,ፒ,ፓ,ፔ,ፕ,ፖ,ፗ"/>
            <Key
                latin:keySpec="ቨ"
                latin:moreKeys="ቩ,ቪ,ቫ,ቬ,ቭ,ቮ,ቯ"/>
            <Key
                latin:keySpec="ኸ"
                latin:moreKeys="ኹ,ኺ,ኻ,ኼ,ኽ,ኾ,ዀ,ዂ,ዃ,ዄ,ዅ"/>
            <Key
                latin:keySpec="፡"
                latin:moreKeys="፦,፧,፨"/>
            <Key
                latin:keySpec="፣"
                latin:moreKeys="፤"/>
            <Key
                latin:keySpec="።"
                latin:moreKeys="፠"/>
            <Key latin:keySpec="፥"/>
        </default>
    </switch>
</merge>
