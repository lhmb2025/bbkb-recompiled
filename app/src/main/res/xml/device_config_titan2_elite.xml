<?xml version="1.0" encoding="utf-8"?>
<!--
    Device Configuration: Unihertz Titan 2 Elite (2026)
    Schema v2.4

    The Titan 2's keyboard (same scancodes) with three differences that matter here: Alt arrives
    as ALT_LEFT (scancode 56), there is no Ctrl key, and Fn sends no key-up and auto-repeats as
    CTRL_LEFT after about 400 ms. Its Alt layer differs from the Titan 2's. Android 16.

    Facts come from published device studies, NOT from a unit in hand: the pad range and the Alt
    layer in particular are unmeasured. Verify on an Elite.
-->

<device-input-config version="2.1" name="Unihertz Titan 2 Elite">

    <device>
        <match>
            <!-- Same device and product as the Titan 2 (Titan_2 / Titan_2_EEA); the board is the
                 Elite's (G72BoardV1). Its Build.DISPLAY also starts "Titan 2 Elite", which a
                 <display regex="Titan 2 Elite.*"/> rule could match instead. -->
            <build-device exact="Titan_2"/>
            <board exact="G72BoardV1"/>
        </match>

        <device-type>PKB</device-type>

        <keypad-layout>qwerty</keypad-layout>

        <!-- Fn sends no key-up and repeats as CTRL_LEFT: Ctrl is a one-shot modifier here, and
             its repeats must not latch the sticky Ctrl mode (ControlModeController). -->
        <quirk name="fn-no-key-up"/>

        <!-- UNVERIFIED: 1080 by 600 is a published figure nobody has measured (about 90 Hz).
             Matched by name, never by event node (event4 on one firmware). No <kdb-variant>:
             swipe typing on this pad stays off until a captured variant exists. -->
        <touch-keypad range-x="1080" range-y="600" contacts="single" native-min-sdk="36" source="auto">
            <input-device exact="touchPad"/>
        </touch-keypad>

        <input-mappings>
            <alt-mappings>
                <source>device_alt_mappings_titan2_elite</source>
                <enabled>true</enabled>
            </alt-mappings>

            <scancode-mappings>

                <key rawScanCode="253" role="BOARD_SYM"
                     treatAs="KEYCODE_SYM" notes="Titan 2 Elite Sym key"/>

                <!-- Fn (251) already arrives as CTRL_LEFT on this model; see the quirk above. -->
                <key rawScanCode="251" role="MODIFIER"
                     treatAs="KEYCODE_CTRL_LEFT" notes="Titan 2 Elite Fn key, Ctrl-like, no key-up"/>

                <key rawScanCode="249" role="FUNCTION" notes="Titan 2 Elite Func1 (programmable)"/>
                <key rawScanCode="250" role="FUNCTION" notes="Titan 2 Elite Func2 (programmable)"/>

                <!-- Alt arrives as ALT_LEFT (scancode 56) on the Elite. -->
                <key rawScanCode="56" role="MODIFIER"
                     treatAs="KEYCODE_ALT_LEFT" notes="Titan 2 Elite Alt key (ALT_LEFT)"/>

                <!-- The Titan 2 ROM line's firmware swipe-left keys; assumed to carry over. -->
                <key rawKeyCode="322" role="GESTURE_SWIPE_LEFT"
                     notes="firmware swipe-left key (Android 15 firmware)"/>
                <key rawKeyCode="404" role="GESTURE_SWIPE_LEFT"
                     notes="firmware swipe-left key (Android 16 firmware)"/>

            </scancode-mappings>
        </input-mappings>

        <settings-overrides>
            <!-- The OEM Cursor assistant owns double-tap: default the slot to no action. -->
            <setting key="ckb_gesture_double_tap" type="string" default-value="none"/>
        </settings-overrides>
    </device>

</device-input-config>
