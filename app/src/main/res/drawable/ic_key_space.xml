<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Center bar - stretches to fill available width between legs -->
    <item
        android:left="2dp"
        android:right="2dp"
        android:height="2dp"
        android:gravity="bottom|fill_horizontal"
        android:drawable="@drawable/ic_key_space_center"/>
    <!-- Left leg - fixed 6dp width, 18dp height, anchored left -->
    <item
        android:width="2dp"
        android:height="6dp"
        android:gravity="left|bottom"
        android:drawable="@drawable/ic_key_space_left"/>
    <!-- Right leg - fixed 6dp width, 18dp height, anchored right -->
    <item
        android:width="2dp"
        android:height="6dp"
        android:gravity="right|bottom"
        android:drawable="@drawable/ic_key_space_right"/>
</layer-list>
