    <!-- Material FCC action chips (colors applied at runtime by FccView).
         Weighted 0dp widths so the row always fits, on any screen width. -->
    <style name="FccMaterialChip" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginStart">3dp</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="FccMaterialChipIcon" parent="">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
    </style>
    <style name="FccMaterialChipLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:textSize">13sp</item>
        <!-- maxLines, not the deprecated singleLine: singleLine additionally forces the
             horizontal-scroll transformation, which is never what these labels want. -->
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="SuggestionWord" parent="">
        <item name="android:textSize">@dimen/config_suggestion_text_size</item>
        <item name="android:ellipsize">none</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:focusable">false</item>
        <item name="android:clickable">false</item>
        <item name="android:minWidth">@dimen/config_suggestion_min_width</item>
        <!-- maxLines, not the deprecated singleLine (see FccMaterialChipLabel above).
             ellipsize stays "none" here: the strip sizes itself to the word. -->
        <item name="android:maxLines">1</item>
        <item name="android:soundEffectsEnabled">false</item>
        <item name="android:hapticFeedbackEnabled">false</item>
        <item name="android:paddingStart">@dimen/config_suggestion_text_horizontal_padding</item>
        <item name="android:paddingEnd">@dimen/config_suggestion_text_horizontal_padding</item>
    </style>
    <style name="SuggestionWord.LXX" parent="@style/SuggestionWord">
