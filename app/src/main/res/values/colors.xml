    <!-- Tint for the word the add-to-dictionary chip points at. Applied as a
         BackgroundColorSpan on text the HOST APP draws in its own colour, so it must not
         assume dark text: the old opaque #d1e7b7 left white text unreadable in any
         dark-themed app (KEY2, 2026-09-15). 40% of the brand green composites over the
         app background instead - darker on dark, lighter on light - so either text
         colour stays legible. -->
    <color name="text_decorator_add_to_dictionary_indicator_text_highlight_color">#664eb848</color>
    
