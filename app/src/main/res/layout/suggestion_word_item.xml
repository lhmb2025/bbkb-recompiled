<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/suggestion_word_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingStart="@dimen/config_suggestion_text_horizontal_padding"
        android:paddingEnd="@dimen/config_suggestion_text_horizontal_padding"
        android:textSize="@dimen/config_suggestion_text_size"
        android:ellipsize="middle"
        android:maxLines="1" />

    <!-- More suggestions indicator (3-dot icon) - shown on center suggestion when more suggestions available -->
    <ImageView
        android:id="@+id/more_suggestions_indicator"
        android:layout_width="16dp"
        android:layout_height="8dp"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="2dp"
        android:alpha="0.5"
        android:src="@drawable/ic_suggestions_more"
        android:visibility="gone" />

</FrameLayout>
