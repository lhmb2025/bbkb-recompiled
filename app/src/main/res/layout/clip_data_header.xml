<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="90dp"
    android:background="@android:color/transparent">

    <!-- Background Actions Layer (Hidden by default, revealed on swipe) -->
    <LinearLayout
        android:id="@+id/clipboard_background_actions"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Share Button (takes up the left side) -->
        <ImageButton
            android:id="@+id/button_share"
            android:layout_width="90dp"
            android:layout_height="match_parent"
            android:src="@drawable/ic_inputboard_clipboard_share"
            android:scaleType="center"
            android:background="@color/swipe_background_share"
            android:contentDescription="Share"/>

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/button_delete"
            android:layout_width="90dp"
            android:layout_height="match_parent"
            android:src="@drawable/ic_inputboard_clipboard_delete"
            android:scaleType="center"
            android:background="@color/swipe_background_delete"
            android:contentDescription="Delete"/>
    </LinearLayout>

    <!-- Foreground Content Layer (What the user sees and swipes) -->
    <RelativeLayout
        android:id="@+id/clipboard_foreground"
        android:orientation="vertical"
        android:background="@color/input_board_background_color"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/clipboard_image_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:layout_alignParentStart="true">
            <ImageView
                android:id="@+id/clipboard_image"
                android:layout_width="@dimen/config_clipboard_view_clip_data_image_width"
                android:layout_height="@dimen/config_clipboard_view_clip_data_image_height"
                android:layout_marginLeft="13dp"
                android:layout_marginTop="17dp"
                android:layout_marginRight="13dp"
                android:contentDescription="@string/clip_data_image_description"/>
        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/clipboard_text_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            android:layout_toEndOf="@+id/clipboard_image_container"
            android:layout_alignParentStart="false">
            <ImageView
                android:id="@+id/divider_image"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginTop="17dp"
                android:layout_marginBottom="17dp"
                android:scaleType="centerCrop"/>
            <TextView
                android:textAppearance="?android:attr/textAppearanceListItem"
                android:textColor="#ffffffff"
                android:ellipsize="end"
                android:id="@+id/clipboard_data_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:layout_marginBottom="17dp"
                android:maxLines="3"
                android:scrollHorizontally="true"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
        </LinearLayout>
    </RelativeLayout>

</FrameLayout>
