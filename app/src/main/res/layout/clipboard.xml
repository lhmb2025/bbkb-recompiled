<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.recyclerview.widget.RecyclerView
            android:scrollbarSize="2dp"
            android:id="@+id/clipboardView"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <FrameLayout
            android:orientation="vertical"
            android:id="@+id/empty_clipboard"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/empty_clipboard_graphic"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/config_clipboard_empty_margin_vertical"
                android:layout_marginBottom="@dimen/config_clipboard_empty_margin_vertical"
                android:src="@drawable/ic_inputboard_clipboard_empty"
                android:layout_marginStart="@dimen/config_clipboard_empty_margin_horizontal"
                android:layout_marginEnd="@dimen/config_clipboard_empty_margin_horizontal"/>
            <TextView
                android:textColor="#9e9e9e"
                android:gravity="bottom|center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="@dimen/config_empty_user_hint_margin_vertical"
                android:text="@string/clipboard_empty_user_hint"/>
            <TextView
                android:textColor="#9e9e9e"
                android:gravity="bottom|center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="@dimen/config_empty_indicator_margin_vertical"
                android:text="@string/clipboard_empty_indicator"/>
        </FrameLayout>
    </RelativeLayout>
</merge>
