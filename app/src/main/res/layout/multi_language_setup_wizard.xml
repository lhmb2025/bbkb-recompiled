<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:scrollbarStyle="outsideOverlay"
    android:padding="@dimen/settings_scrollview_padding"
    android:scrollbars="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:overScrollMode="ifContentScrolls"
    android:layout_marginStart="@dimen/settings_scrollview_horizontal_margin"
    android:layout_marginEnd="@dimen/settings_scrollview_horizontal_margin">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/multilang_setup_top"
        android:padding="@dimen/settings_linear_layout_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:layout_marginStart="@dimen/settings_linear_layout_horizontal_margin"
        android:layout_marginEnd="@dimen/settings_linear_layout_horizontal_margin">
        <TextView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/multi_language_setup_explanation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/multi_language_input_setup_explanation"
            android:paddingStart="@dimen/settings_text_horizontal_padding"
            android:paddingEnd="@dimen/settings_text_horizontal_padding"
            android:layout_marginStart="@dimen/settings_text_horizontal_margin"
            android:layout_marginEnd="@dimen/settings_text_horizontal_margin"
            style="?android:attr/textAppearanceSmall"/>
        <LinearLayout
            android:layout_gravity="start|center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingStart="@dimen/settings_text_horizontal_padding"
            android:paddingEnd="@dimen/settings_text_horizontal_padding"
            android:layout_marginStart="@dimen/settings_text_horizontal_margin"
            android:layout_marginEnd="@dimen/settings_text_horizontal_margin">
            <TextView
                android:textStyle="bold"
                android:gravity="start"
                android:layout_gravity="start|center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:text="@string/multi_language_input_primary_language_title"
                android:layout_weight="30"
                android:textAlignment="viewStart"
                android:layout_marginStart="8dp"
                style="?android:attr/textAppearanceSmall"/>
            <Spinner
                android:id="@+id/primary_locale_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:prompt="@string/multi_language_input_support_language_spinner_dialog_title"
                android:spinnerMode="dropdown"/>
            <TextView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/multi_lang_primary_locale_explanation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/multi_language_input_setup_primary_language_explanation"
                android:paddingStart="@dimen/settings_text_horizontal_padding"
                android:paddingEnd="@dimen/settings_text_horizontal_padding"
                android:layout_marginStart="@dimen/settings_text_horizontal_margin"
                android:layout_marginEnd="@dimen/settings_text_horizontal_margin"
                style="?android:attr/textAppearanceSmall"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="start|center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingStart="@dimen/settings_text_horizontal_padding"
            android:paddingEnd="@dimen/settings_text_horizontal_padding"
            android:layout_marginStart="@dimen/settings_text_horizontal_margin"
            android:layout_marginEnd="@dimen/settings_text_horizontal_margin">
            <TextView
                android:textStyle="bold"
                android:gravity="start"
                android:layout_gravity="start|center_vertical"
                android:id="@+id/multi_lang_setup_support_lang_title"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:text="@string/multi_language_input_supportive_language_title"
                android:layout_weight="30"
                android:textAlignment="viewStart"
                android:layout_marginStart="8dp"
                style="?android:attr/textAppearanceSmall"/>
            <Spinner
                android:id="@+id/supporting_locales_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:prompt="@string/multi_language_input_support_language_spinner_dialog_title"
                android:spinnerMode="dropdown"/>
            <TextView
                android:layout_gravity="start|center_vertical"
                android:id="@+id/multi_lang_support_locale_explanation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/multi_language_input_setup_supportive_language_explanation"
                android:paddingStart="@dimen/settings_text_horizontal_padding"
                android:paddingEnd="@dimen/settings_text_horizontal_padding"
                android:layout_marginStart="@dimen/settings_text_horizontal_margin"
                android:layout_marginEnd="@dimen/settings_text_horizontal_margin"
                style="?android:attr/textAppearanceSmall"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
