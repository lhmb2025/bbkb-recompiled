<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/config_cjk_font_size"
        android:layout_gravity="center"
        android:id="@+id/suggested_word"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/config_cjk_strip_horizontal_margin_half"
        android:layout_marginRight="@dimen/config_cjk_strip_horizontal_margin_half"
        style="?attr/suggestionWordStyle"/>
</LinearLayout>
